@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix an: <https://w3id.org/castello-anima-vocab/> .
@prefix ed: <https://w3id.org/castello-edizione-vocab/> .

# Allineamento castello-anima-vocab  <->  castello-edizione-vocab (Fase 2 SKOS)
# closeMatch
an:mystic_state-quiete skos:closeMatch ed:quiete .
an:mystic_state-otium skos:closeMatch ed:otio .
an:mystic_state-unione skos:closeMatch ed:unione .
an:mystic_state-illuminazione skos:closeMatch ed:contemplazione-infusa .
# narrowMatch (il concetto 'anima' e' piu' ampio del corrispettivo 'edizione')
an:mystic_state-purificazione skos:narrowMatch ed:purga .
an:mystic_state-purificazione skos:narrowMatch ed:notte .
# relatedMatch (relazione 'anima' <-> concetto 'edizione')
an:relation-mistica-unione-sposalitio skos:relatedMatch ed:matrimonio-spirituale .
an:relation-mistica-unione-sposalitio skos:relatedMatch ed:trasformazione .
an:relation-mistica-infusa-purificazione skos:relatedMatch ed:contemplazione-infusa .
an:relation-mistica-passiva-quiete skos:relatedMatch ed:quiete .
