<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="https://jenkins.tei-c.org/job/TEIP5-dev/lastSuccessfulBuild/artifact/P5/release/xml/tei/custom/schema/relaxng/tei_odds.rng"
            type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0"
     xmlns:sch="http://purl.oclc.org/dsdl/schematron"
     xml:lang="it">
  <teiHeader>
    <fileDesc>
      <titleStmt>
        <title>Castello dell'anima — ODD del modello del testo (teiText)</title>
        <title type="sub">Intertestualità sotto sorveglianza · modello TEI-driven e AI-assisted</title>
        <author>Luciano Longo</author>
        <respStmt>
          <resp>Autrice del testo codificato</resp>
          <name>Teresa di San Geronimo (Anna La Longa, 1670–post 1703)</name>
        </respStmt>
      </titleStmt>
      <publicationStmt>
        <publisher>Progetto «Il Castello dell'anima»</publisher>
        <availability status="restricted">
          <licence target="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</licence>
        </availability>
      </publicationStmt>
      <sourceDesc>
        <p>ODD nativo del progetto. Formalizza in un unico sorgente il modello di codifica
           del <gi>text</gi> già documentato in prosa in
           <ref target="../docs/teiText-guida-codifica.md">docs/teiText-guida-codifica.md</ref>
           (Parte 2 «Vincoli» e Appendice «Liste di valori»). Non sostituisce la catena di
           validazione attiva (<ref target="tei_all.rng">tei_all.rng</ref> +
           <ref target="impactindex.sch">impactindex.sch</ref> + 8 guardie Python): la
           <emph>affianca</emph> come fonte normativa derivabile.</p>
      </sourceDesc>
    </fileDesc>
    <encodingDesc>
      <projectDesc>
        <p>Catena ODD → RNG + Schematron. Generazione (fuori CI) con Roma oppure
           <code>oddc</code>/TEI Stylesheets, pinnata a TEI P5 versione 4.12.0 per
           coincidere con lo schema vendorizzato <ref target="tei_all.rng">tei_all.rng</ref>.</p>
      </projectDesc>
    </encodingDesc>
    <revisionDesc>
      <change when="2026-11-17" who="#editor">Prima stesura dell'ODD del testo: selezione
        moduli (inventario a 46 elementi), vocabolari chiusi §2.1, vincoli strutturali §2.2.</change>
    </revisionDesc>
  </teiHeader>

  <text>
    <body>
      <div xml:id="intro">
        <head>Modello del testo — specifica</head>
        <p>Questo ODD descrive il sottoinsieme TEI P5 effettivamente usato dal
          <ref target="../tei/text/castello-anima-teiText.xml">teiText</ref> (46 elementi
          distinti su ~600 di TEI All) e i vocabolari controllati dei suoi attributi. È un
          ODD <emph>documentale</emph>: riduce TEI All ai moduli impiegati e dichiara le
          liste di valori chiuse, senza potature che rigettino il testo costituito.</p>
      </div>

      <div xml:id="schema">
        <head>Schema specification</head>

        <schemaSpec ident="castello-anima-text" start="TEI" docLang="it" prefix="cast_"
                    source="https://www.tei-c.org/Vault/P5/4.12.0/xml/tei/odd/p5subset.xml">

          <!-- ==== Moduli TEI selezionati (calibrati sull'inventario §2.3) ==== -->
          <moduleRef key="tei"/>              <!-- infrastruttura, att.global, @cert/@resp/@hand -->
          <moduleRef key="header"/>           <!-- teiHeader, editorialDecl, classDecl, taxonomy, xenoData -->
          <moduleRef key="core"/>             <!-- p head title bibl cit quote note ref ptr term date foreign gap hi soCalled pb lb milestone -->
          <moduleRef key="textstructure"/>    <!-- TEI text body div argument trailer titlePage titlePart fw -->
          <moduleRef key="transcr"/>          <!-- add del subst restore retrace metamark supplied anchor -->
          <moduleRef key="textcrit"/>         <!-- app lem rdg (apparato sostanziale parallel-segmentation) -->
          <moduleRef key="linking"/>          <!-- standOff link linkGrp ab anchor -->
          <moduleRef key="analysis"/>         <!-- seg span spanGrp interp interpGrp -->
          <moduleRef key="iso-fs"/>           <!-- fs f symbol numeric (indice d'impatto) -->
          <moduleRef key="namesdates"/>       <!-- orgName persName placeName -->
          <moduleRef key="msdescription"/>    <!-- msDesc nell'header (descrizione del testimone) -->

          <!-- ==== Vocabolari chiusi (guida §2.1) ==== -->

          <elementSpec ident="div" mode="change">
            <desc versionDate="2026-11-17" xml:lang="it">Libro, prefazione o capitolo.</desc>
            <attList>
              <attDef ident="type" mode="change" usage="req">
                <valList type="semi">
                  <valItem ident="book"><gloss>Libro (I, II, III)</gloss></valItem>
                  <valItem ident="preface"><gloss>Prefazione</gloss></valItem>
                  <valItem ident="proem"><gloss>Proemio</gloss></valItem>
                  <valItem ident="chapter"><gloss>Capitolo</gloss></valItem>
                  <valItem ident="section"><gloss>Sezione interna</gloss></valItem>
                  <valItem ident="sub-section"><gloss>Sotto-sezione</gloss></valItem>
                </valList>
              </attDef>
            </attList>
          </elementSpec>

          <elementSpec ident="add" mode="change">
            <attList>
              <attDef ident="type" mode="change">
                <valList type="semi">
                  <valItem ident="correction"/><valItem ident="substitution"/><valItem ident="addition"/>
                  <valItem ident="integration"/><valItem ident="punctuation"/>
                </valList>
              </attDef>
              <attDef ident="place" mode="change">
                <valList type="semi">
                  <valItem ident="above"/><valItem ident="below"/><valItem ident="inline"/><valItem ident="margin"/>
                  <valItem ident="interlinear"/><valItem ident="interlinear-above"/><valItem ident="supralinear"/>
                  <valItem ident="margin-left"/><valItem ident="margin-right"/>
                </valList>
              </attDef>
            </attList>
          </elementSpec>

          <elementSpec ident="del" mode="change">
            <attList>
              <attDef ident="type" mode="change">
                <valList type="closed">
                  <valItem ident="correction"/><valItem ident="deletion"/><valItem ident="substitution"/>
                  <valItem ident="integration"/><valItem ident="punctuation"/>
                </valList>
              </attDef>
              <attDef ident="place" mode="change">
                <valList type="semi">
                  <valItem ident="above"/><valItem ident="below"/><valItem ident="inline"/><valItem ident="margin"/>
                  <valItem ident="interlinear"/><valItem ident="interlinear-above"/><valItem ident="supralinear"/>
                  <valItem ident="margin-left"/><valItem ident="margin-right"/>
                </valList>
              </attDef>
              <attDef ident="rend" mode="change">
                <valList type="semi">
                  <valItem ident="strikethrough"/><valItem ident="erased"/><valItem ident="overwritten"/>
                  <valItem ident="expunged"/><valItem ident="crossed"/>
                </valList>
              </attDef>
            </attList>
          </elementSpec>

          <elementSpec ident="gap" mode="change">
            <attList>
              <attDef ident="reason" mode="change">
                <valList type="semi">
                  <valItem ident="illegible"/><valItem ident="damage"/><valItem ident="ink-fade"/>
                  <valItem ident="abrasion"/><valItem ident="binding"/><valItem ident="hole"/>
                  <valItem ident="stain"/><valItem ident="trimmed"/><valItem ident="cancelled"/>
                </valList>
              </attDef>
              <attDef ident="unit" mode="change">
                <valList type="closed">
                  <valItem ident="char"/><valItem ident="chars"/><valItem ident="word"/>
                  <valItem ident="words"/><valItem ident="line"/><valItem ident="lines"/>
                </valList>
              </attDef>
            </attList>
          </elementSpec>

          <elementSpec ident="unclear" mode="change">
            <attList>
              <attDef ident="reason" mode="change">
                <valList type="closed">
                  <valItem ident="illegible"/><valItem ident="damage"/><valItem ident="ink-fade"/>
                  <valItem ident="abrasion"/><valItem ident="binding"/><valItem ident="hole"/>
                  <valItem ident="stain"/><valItem ident="trimmed"/>
                </valList>
              </attDef>
            </attList>
          </elementSpec>

          <elementSpec ident="supplied" mode="change">
            <attList>
              <attDef ident="reason" mode="change">
                <valList type="semi"><valItem ident="hole"><gloss>cause materiali, come gap/@reason</gloss></valItem></valList>
              </attDef>
              <attDef ident="unit" mode="change">
                <valList type="closed">
                  <valItem ident="char"/><valItem ident="chars"/><valItem ident="word"/>
                  <valItem ident="words"/><valItem ident="line"/><valItem ident="lines"/>
                </valList>
              </attDef>
            </attList>
          </elementSpec>

          <elementSpec ident="app" mode="change">
            <desc versionDate="2026-11-17" xml:lang="it">Apparato sostanziale (parallel-segmentation).
              Le varianti IA controfattuali usano <att>type</att> con prefisso <val>workflow-</val>.</desc>
            <attList>
              <attDef ident="type" mode="change">
                <valList type="semi">
                  <valItem ident="substitution"/><valItem ident="addition"/><valItem ident="deletion"/>
                  <valItem ident="transposition"/><valItem ident="variant"/>
                </valList>
              </attDef>
            </attList>
          </elementSpec>

          <elementSpec ident="rdg" mode="change">
            <attList>
              <attDef ident="type" mode="change">
                <valList type="closed">
                  <valItem ident="authorial"/><valItem ident="external"/>
                </valList>
              </attDef>
              <attDef ident="cause" mode="change">
                <valList type="closed">
                  <valItem ident="correction"/><valItem ident="clarification"/><valItem ident="orthodoxy"/>
                  <valItem ident="attenuation"/><valItem ident="precision"/><valItem ident="amplification"/>
                </valList>
              </attDef>
            </attList>
          </elementSpec>

          <elementSpec ident="note" mode="change">
            <attList>
              <attDef ident="type" mode="change">
                <valList type="semi">
                  <valItem ident="editorial"/><valItem ident="doctrinal"/><valItem ident="contextual"/>
                  <valItem ident="glossa"/><valItem ident="critical"/><valItem ident="linguistic"/><valItem ident="material"/>
                </valList>
              </attDef>
            </attList>
          </elementSpec>

          <elementSpec ident="hi" mode="change">
            <attList>
              <attDef ident="rend" mode="change">
                <valList type="semi">
                  <valItem ident="italic"/><valItem ident="underline"/><valItem ident="superscript"/>
                  <valItem ident="larger"/><valItem ident="spaced"/><valItem ident="rubric"/>
                </valList>
              </attDef>
            </attList>
          </elementSpec>

          <elementSpec ident="fw" mode="change">
            <attList>
              <attDef ident="type" mode="change">
                <valList type="closed">
                  <valItem ident="header"/><valItem ident="footer"/><valItem ident="pageNum"/>
                  <valItem ident="sig"/><valItem ident="catch"/>
                </valList>
              </attDef>
            </attList>
          </elementSpec>

          <!-- @cert globale: low/medium/high -->
          <classSpec ident="att.global.responsibility" mode="change" type="atts">
            <attList>
              <attDef ident="cert" mode="change">
                <valList type="closed">
                  <valItem ident="low"/><valItem ident="medium"/><valItem ident="high"/>
                </valList>
              </attDef>
            </attList>
          </classSpec>

          <!-- ==== Vincoli strutturali (guida §2.2) come Schematron, incorporati nell'ODD ====
               Nota: lo Schematron attivo in CI resta impactindex.sch (indice d'impatto, R1/R2/R3).
               Qui si formalizzano i vincoli strutturali oggi presidiati dalle guardie Python,
               perché derivabili dallo stesso sorgente ODD. -->
          <constraintSpec ident="subst-add-del" scheme="schematron">
            <constraint>
              <sch:rule context="tei:subst">
                <sch:assert test="tei:add and tei:del">Ogni &lt;subst&gt; contiene almeno un &lt;add&gt; e un &lt;del&gt;.</sch:assert>
              </sch:rule>
            </constraint>
          </constraintSpec>

          <constraintSpec ident="lem-ultima-volonta" scheme="schematron">
            <constraint>
              <sch:rule context="tei:lem[@wit]">
                <sch:assert test="contains(concat(' ',normalize-space(@wit),' '),' #txt-c ')">La lezione costituita (&lt;lem&gt;) porta il testimone #txt-c (ultima volontà).</sch:assert>
              </sch:rule>
            </constraint>
          </constraintSpec>

          <constraintSpec ident="ia-solo-in-rdg" scheme="schematron">
            <constraint>
              <sch:rule context="tei:*[@resp]">
                <sch:report test="contains(concat(' ',normalize-space(@resp),' '),' #AI_controllata ') and not(self::tei:rdg)">L'attribuzione #AI_controllata è ammessa solo su &lt;rdg&gt; (strato sperimentale IA).</sch:report>
              </sch:rule>
            </constraint>
          </constraintSpec>

        </schemaSpec>
      </div>

      <div xml:id="note-ana">
        <head>Assi <att>ana</att> e vocabolari di puntatori</head>
        <p>Gli assi interpretativi di <att>ana</att> (8 tassonomie), le mani (<att>hand</att>),
          i testimoni (<att>wit</att>), le entità (<att>ref</att>/<att>resp</att>), le figure
          (<ref target="#">#fig-*</ref>), le aree (<ref target="#">#area-*</ref>) e i workflow
          IA (<ref target="#">#workflow-*</ref>) sono vocabolari <emph>a puntatore</emph>: i loro
          valori sono dichiarati nel <gi>classDecl</gi>/<gi>taxonomy</gi> del
          <ref target="../tei/header/castello-anima-teiHeader.xml">teiHeader</ref> e nella
          tassonomia normativa <ref target="../tei/taxonomy/tassonomia-gh.xml">tassonomia-gh.xml</ref>,
          e sono verificati in CI dalla guardia E2 (ogni token <att>ana</att> risolve a una
          categoria dichiarata) e dal vocabolario SKOS. Non si duplicano qui come
          <gi>valList</gi>: l'integrità referenziale è presidio di CI, non di schema. Inventario
          completo nell'Appendice A1–A7 della guida di codifica.</p>
      </div>
    </body>
  </text>
</TEI>
